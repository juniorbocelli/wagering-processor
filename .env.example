# Aplicação (runtime) — conecta como wagering_app (sem DDL, sem ser dona das tabelas)
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering
# Migrations — conecta como wagering_owner
MIGRATION_DATABASE_URL=postgres://wagering_owner:wagering_owner@localhost:5432/wagering
# Testes de integração
TEST_DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering_test
TEST_MIGRATION_DATABASE_URL=postgres://wagering_owner:wagering_owner@localhost:5432/wagering_test

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SUPPORTED_CURRENCIES=BRL,USD,EUR
PORT=3000
LOG_LEVEL=info
# Pool de conexões do runtime (20)
DB_POOL_MAX=20
# Reconciliação periódica de todas as wallets (ADR-012): intervalo (300000 = 5 min)
RECONCILIATION_INTERVAL_MS=300000

# Mensageria (padrões entre parênteses; a fila e a DLQ são FIFO)
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
EVENTS_QUEUE_NAME=wallet-events.fifo
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SHUTDOWN_GRACE_MS=20000
# Outbox: intervalo de polling (300) e validade do lease do publisher (30000)
OUTBOX_POLL_INTERVAL_MS=300
OUTBOX_LEASE_MS=30000
# Referências pendentes: intervalo da varredura (500)
PENDING_REFERENCE_POLL_INTERVAL_MS=500
# Retenção (ADR-011): intervalo (600000), outbox publicada (72 h), inbox (7 d), lote (1000)
RETENTION_INTERVAL_MS=600000
OUTBOX_RETENTION_HOURS=72
INBOX_RETENTION_DAYS=7
RETENTION_BATCH_SIZE=1000
# Injeção de falhas (somente testes; vazio em produção). Valores aceitos:
# crash_after_commit_before_ack | crash_after_publish_before_mark
FAULT_INJECTION=
