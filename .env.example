# Aplicação (runtime) — conecta como wagering_app (sem DDL, sem ser dona das tabelas)
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering
# Migrations — conecta como wagering_owner
MIGRATION_DATABASE_URL=postgres://wagering_owner:wagering_owner@localhost:5432/wagering
# Testes de integração
TEST_DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering_test
TEST_MIGRATION_DATABASE_URL=postgres://wagering_owner:wagering_owner@localhost:5432/wagering_test

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SUPPORTED_CURRENCIES=BRL,USD,EUR
PORT=3000
LOG_LEVEL=info
